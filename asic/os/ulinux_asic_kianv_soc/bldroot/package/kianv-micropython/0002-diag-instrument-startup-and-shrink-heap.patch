+/* DIAG: never block on entropy. CONFIG_HW_RANDOM is not set in the
+ * kianv kernel, so a freshly booted noMMU userspace can sit in
+ * getrandom(.., 0) forever waiting for the pool to seed. Try
+ * GRND_INSECURE (returns immediately with whatever entropy exists,
+ * Linux 5.6+), fall back to GRND_NONBLOCK, fall back to a fixed seed. */
+#ifndef GRND_NONBLOCK
+#define GRND_NONBLOCK 0x1u
+#endif
+#ifndef GRND_INSECURE
+#define GRND_INSECURE 0x4u
+#endif
+
 void mp_hal_get_random(size_t n, void *buf) {
     #ifdef _HAVE_GETRANDOM
-    RAISE_ERRNO(getrandom(buf, n, 0), errno);
+    int ret = getrandom(buf, n, GRND_INSECURE);
+    if (ret < 0) {
+        ret = getrandom(buf, n, GRND_NONBLOCK);
+    }
+    if (ret < 0) {
+        /* Last-ditch: deterministic non-zero fill so callers don't see all-0. */
+        for (size_t i = 0; i < n; i++) ((unsigned char *)buf)[i] = (unsigned char)(0xa5 ^ i);
+    }
     #else
     int fd = open("/dev/urandom", O_RDONLY);
     RAISE_ERRNO(fd, errno);
